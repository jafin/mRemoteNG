<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway spike for openspec change add-native-ssh-terminal, tasks 1.1 / 1.2 / 1.3.
    Deliberately NOT in mRemoteNG.sln: it must not affect build.ps1, CI or the test run.
    Build it directly:  dotnet build spikes/native-ssh-terminal/NativeTerminalSpike
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>NativeTerminalSpike</AssemblyName>
    <RootNamespace>NativeTerminalSpike</RootNamespace>

    <!-- A spike is measured, not linted. Keeps the loop fast; nothing here ships. -->
    <RunAnalyzers>false</RunAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA1416;CS8618;CS8622</NoWarn>
    <WarningsAsErrors />
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions come from the repo's Directory.Packages.props (central package management). -->
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
